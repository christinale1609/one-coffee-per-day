# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase > Project Settings > API (or "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (sb_publishable_...). An older "anon" key works too.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Anthropic Console > API Keys (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: which Claude model to use. Defaults to claude-opus-5-5.
# claude-haiku-5-5 is much cheaper if you want to save credits while testing.
# ANTHROPIC_MODEL=claude-opus-5-5
